{
  "name": "secureota-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the Blockchain-Secured IoT Firmware Console",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "bundle:ui": "node scripts/bundle-renderer.cjs",
    "build:app": "tsc && node scripts/bundle-renderer.cjs",
    "start": "electron .",
    "dist": "npm run build:app && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2"
  },
  "build": {
    "appId": "com.controlbackspace.secureota",
    "productName": "SecureOTA",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../gateway",
        "to": "gateway",
        "filter": [
          "**/*",
          "!.venv/**/*",
          "!artifacts/**/*",
          "!fixtures/**/*",
          "!**/__pycache__/**/*",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
