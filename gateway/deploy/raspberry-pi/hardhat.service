[Unit]
Description=Hardhat local blockchain node for the Delta-OTA ledger
After=network.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__/blockchain
ExecStart=__ROOT__/blockchain/node_modules/.bin/hardhat node
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target